{
  "rules": [
    {
      "match": "^設計レビューで差し戻されました。[\\s\\S]*E2E-6701 の指摘",
      "steps": [
        {
          "tool": "mcp__sukuna__report_design",
          "input": { "number": 6701, "policy": "指摘を反映した新しい修正方針", "checks": [] }
        },
        { "end": "success" }
      ]
    },
    {
      "match": "^#6601「設計レビューの一覧確認」を精査してください。",
      "steps": [
        {
          "tool": "mcp__sukuna__report_triage",
          "input": {
            "number": 6601,
            "result": "design",
            "kind": "enhancement",
            "summary": "設計へ進む"
          }
        },
        { "end": "success" }
      ]
    },
    {
      "match": "^#6601「設計レビューの一覧確認」を設計してください。",
      "steps": [
        {
          "shell": "printf '予約の記録を設計する\n' > design.md && git add design.md && git -c user.name='Test' -c user.email='test@example.test' -c commit.gpgsign=false commit -qm design"
        },
        {
          "tool": "mcp__sukuna__report_design",
          "input": { "number": 6601, "policy": "予約の記録を設計する", "checks": [] }
        },
        { "end": "success" }
      ]
    },
    {
      "match": "^E2E performance [0-9]+$",
      "steps": [
        { "stream": { "prefix": "連続出力 ", "count": 300, "interval_ms": 100 } },
        { "end": "success" }
      ]
    },
    {
      "match": "^#1「予約の監査ログを追加する」を精査してください。",
      "steps": [
        { "text": "予約の監査ログを精査します。" },
        {
          "tool": "mcp__sukuna__report_needs_human",
          "input": {
            "number": 1,
            "questions": [{ "text": "記録する時刻は予約確定時でよいですか？" }],
            "summary": "監査ログに記録する時刻を確かめたい"
          }
        },
        { "end": "success" }
      ]
    },
    {
      "match": "^予約 API を作って$",
      "steps": [
        {
          "text": "確認したいことが2点あります。"
        },
        {
          "ask": [
            {
              "question": "在庫を戻す方法は?",
              "header": "方法",
              "multi_select": false,
              "options": [
                {
                  "label": "定期処理",
                  "description": "1分ごと"
                },
                {
                  "label": "次の処理",
                  "description": "必要なとき"
                }
              ]
            },
            {
              "question": "設定で変えられるようにする?",
              "header": "設定",
              "multi_select": false,
              "options": [{ "label": "はい", "description": "設定で変える" }]
            }
          ]
        },
        {
          "text": "選んだ方針で設計を進めます。"
        },
        {
          "end": "success"
        }
      ]
    },
    {
      "match": "^回答の送信確認を試す$",
      "steps": [
        {
          "ask": [
            {
              "question": "在庫を戻す方法は?",
              "header": "方法",
              "multi_select": false,
              "options": [
                {
                  "label": "定期処理",
                  "description": "1分ごと"
                },
                {
                  "label": "次の処理",
                  "description": "必要なとき"
                }
              ]
            },
            {
              "question": "設定で変えられるようにする?",
              "header": "設定",
              "multi_select": false,
              "options": [
                {
                  "label": "はい",
                  "description": "設定で変える"
                }
              ]
            },
            {
              "question": "履歴を残しますか?",
              "header": "履歴",
              "multi_select": false,
              "options": [
                {
                  "label": "残す",
                  "description": "履歴を保存する"
                }
              ]
            }
          ]
        },
        {
          "text": "回答を受け取りました。"
        },
        {
          "end": "success"
        }
      ]
    },
    {
      "match": "^ストックの確認を始める$",
      "steps": [
        { "text": "在庫を記録します。\n期限を検査します。\n結果を返します。" },
        { "end": "success" }
      ]
    },
    {
      "match": "期限の理由を教えて",
      "steps": [{ "text": "30 分が予約の有効期限です。" }, { "end": "success" }]
    },
    {
      "match": "^このスレッドで確定した事項を",
      "steps": [{ "text": "期限は 30 分に統一します。" }, { "end": "success" }]
    },
    {
      "match": "期限は 30 分に統一します",
      "steps": [{ "text": "期限の設定を確認しました。" }, { "end": "success" }]
    },
    {
      "match": "^タイムラインの作業を始める$",
      "steps": [
        {
          "tool": "Read",
          "input": {
            "file_path": "src/orders/export.ts"
          },
          "result": "既存の書き出しを確認した。"
        },
        {
          "text": "文字コードの判定を終え、注文 CSV の出力を確認しています。"
        },
        {
          "hold": true
        }
      ]
    },
    {
      "match": "^予約 API の通知を確認 notice-[A-Za-z0-9]+$",
      "steps": [
        {
          "shell": "i=0; while [ ! -f .e2e-notice-ready ] && [ \"$i\" -lt 300 ]; do i=$((i + 1)); sleep 0.05; done; test -f .e2e-notice-ready"
        },
        {
          "ask": [
            {
              "question": "在庫を戻す方法は?",
              "header": "方法",
              "multi_select": false,
              "options": [
                {
                  "label": "定期処理",
                  "description": "1分ごと"
                },
                {
                  "label": "次の処理",
                  "description": "必要なとき"
                }
              ]
            }
          ]
        },
        {
          "end": "success"
        }
      ]
    }
  ],
  "completions": [
    {
      "purpose": "recap",
      "match": "回答を受け取りました。",
      "text": "{\"chapter\":{\"kind\":\"new\",\"title\":\"回答の確認\"},\"decisions\":[],\"changes\":[],\"questions\":[],\"answered\":[]}"
    },
    {
      "purpose": "recap",
      "match": "引き当ての期限は 30 分にしてください。",
      "text": "{\"chapter\":{\"kind\":\"continue\"},\"decisions\":[],\"changes\":[],\"questions\":[],\"answered\":[\"recap-navigation-conversation-question\"]}"
    }
  ]
}
